# =============================================================
#  Dr. Gogineni Ratnakara Rao, Apache configuration
#  PLACEHOLDER DOMAIN: replace "www.drratnakararao.com" below
#  with your live domain before going to production.
#  Localhost is exempted from the redirects so WAMP still works.
# =============================================================

Options -Indexes
DirectoryIndex index.html
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Skip all canonicalisation on local development ---
  RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ - [L]

  # --- 1. Force HTTPS (301) ---
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- 2. Force the www canonical host (301) ---
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- 3. Strip index.html so "/" is the only canonical URL (301) ---
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # --- 4. Drop trailing slashes on files, enforce on directories ---
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]
</IfModule>

# =============================================================
#  MIME types
# =============================================================
<IfModule mod_mime.c>
  AddType image/avif             .avif
  AddType image/webp             .webp
  AddType image/svg+xml          .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2             .woff2
</IfModule>

# =============================================================
#  Compression - Brotli first, gzip fallback
# =============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/ld+json \
    application/xml application/rss+xml image/svg+xml font/woff2 \
    text/x-component application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json application/ld+json \
    application/xml application/rss+xml image/svg+xml font/woff2 \
    text/x-component application/manifest+json

  # Never re-compress already-compressed binaries
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|br|mp4|woff2?)$ no-gzip dont-vary
</IfModule>

# =============================================================
#  Cache-Control
#   - HTML: always revalidate (content changes)
#   - Images/fonts/CSS/JS: 1 year immutable (filenames are versioned)
# =============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/json          "access plus 0 seconds"
  ExpiresByType application/ld+json       "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 1 day"

  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|ico|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # Enable once HTTPS is live and verified:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header unset ETag
</IfModule>

FileETag None

# =============================================================
#  Protect dotfiles and backups
# =============================================================
<FilesMatch "(^\.|\.(bak|config|log|sql|ini|sh)$)">
  Require all denied
</FilesMatch>
